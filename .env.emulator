# Test mode — used by `npm run dev:test` (vite --mode emulator).
# Points the app at the local Firebase emulators instead of the real café database.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099

# Login that exists ONLY inside the local Auth emulator (created by `npm run test:reset`).
# Not a real account — safe to keep in the repo.
VITE_TEST_LOGIN_EMAIL=prueba@bubblekaapeh.test
VITE_TEST_LOGIN_PASSWORD=prueba-ea20484b

rules_version = '2';

// Reconstructed from actual usage in this codebase (no live rules were fetched
// from the Firebase console — this repo previously had no firestore.rules file
// tracked at all, see digitalMenu.md). Convention matches the one already
// confirmed live for `settings/general` (digitalMenu.md, 2026-08-04): public
// read where the customer-facing menu/checkout needs it, `request.auth != null`
// (any authenticated admin account) everywhere else — this app has no roles at
// the Firestore level, only the app-level station/PIN system layered on top.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public catalog — read by the unauthenticated customer menu (Home.jsx
    // and the hooks/components it renders) ──────────────────────────────────
    match /sections/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /products/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /combos/{id}      { allow read: if true; allow write: if request.auth != null; }
    match /toppings/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /carousel/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /promotions/{id}  { allow read: if true; allow write: if request.auth != null; }

    // settings/general — publicly readable (adminPin fallback + the
    // authorizedEmails allowlist check both run before a user is
    // authenticated); writable only once signed in.
    match /settings/{id}    { allow read: if true; allow write: if request.auth != null; }

    // web_orders — the public menu's "Pedir por WhatsApp" saves the cart here
    // (src/utils/webOrders.js). Anyone may CREATE a pending order with the
    // expected shape; only signed-in staff can see, import or ignore them.
    match /web_orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['orderId', 'items', 'total', 'generalNote', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.orderId is string
                    && request.resource.data.orderId.size() <= 24
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 60
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && (request.resource.data.generalNote == null
                        || (request.resource.data.generalNote is string
                            && request.resource.data.generalNote.size() <= 500))
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if request.auth != null;
    }

    // orders — tickets the café actually took (POS, kitchen, paid). Staff
    // only: the public menu writes to web_orders instead and no longer reads
    // or trims this collection.
    match /orders/{id}      { allow read, write: if request.auth != null; }

    // ── Admin-only collections — no customer-facing access needed ──────────
    match /customers/{id}         { allow read, write: if request.auth != null; }
    match /parked_orders/{id}     { allow read, write: if request.auth != null; }
    match /register_sessions/{id} { allow read, write: if request.auth != null; }
    match /rawMaterials/{id}      { allow read, write: if request.auth != null; }
    match /recipes/{id}           { allow read, write: if request.auth != null; }
    match /stockMovements/{id}    { allow read, write: if request.auth != null; }
    match /expenses/{id}          { allow read, write: if request.auth != null; }
    match /stations/{id}          { allow read, write: if request.auth != null; }

    // Deny everything else by default (Firestore's own default when no match
    // block applies) — no catch-all rule is added here on purpose, so any
    // future collection needs an explicit block above before it works.
  }
}
